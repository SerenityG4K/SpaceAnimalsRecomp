// Ressources du launcher : icône, manifeste (DPI par écran), informations de version.
#include <winver.h>

1 ICON "icone.ico"
1 24 "lanceur.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "FileDescription", "StarFox Remake [recompiled] - launcher"
            VALUE "FileVersion", "1.0.2"
            VALUE "ProductName", "StarFox Remake [recompiled] (SpaceAnimalsRecomp)"
            VALUE "ProductVersion", "1.0.2"
            VALUE "OriginalFilename", "lanceur.exe"
            VALUE "CompanyName", "SerenityG4K"
            VALUE "LegalCopyright", "SerenityG4K - GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
